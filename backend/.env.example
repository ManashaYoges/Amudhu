# Amudhu AI Vision & Nutrition Backend Configuration
# Port for the Express server (default 3000)
PORT=3000

# Google Gemini Vision API Key (Recommended - Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Vision Model: gemini-1.5-flash (fastest & accurate), gemini-2.0-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# AI Provider: gemini or openai
AI_PROVIDER=gemini

# Optional: OpenAI API Key if using GPT-4o Vision instead of Gemini
# OPENAI_API_KEY=your_openai_api_key_here
