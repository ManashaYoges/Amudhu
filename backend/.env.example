PORT=3000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.<cluster_id>.mongodb.net/amudhu?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Optional meal image analysis provider credentials (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini
OPENAI_API_KEY=

# Required to enable password reset emails. The user enters the emailed token
# in the app, which POSTs it to /api/auth/password-reset/confirm.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
